ENVIRONMENT=development
DATABASE_URL=postgresql://nara:nara@localhost:5432/nara
TEST_DATABASE_URL=postgresql://nara:nara@localhost:5432/nara_test

# At least 32 characters outside development (try: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=development-only-secret-do-not-ship-this
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
# "lax" suits the single-origin production image and the Vite dev proxy.
# Only use "none" if the API is on a different domain to the app, and then it must be HTTPS.
COOKIE_SAMESITE=lax

# In production the API serves the built frontend from STATIC_DIR, so both of these are the
# same public URL and CORS_ORIGINS can usually be left as just that one origin.
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
STATIC_DIR=static

# Transactional email (Resend). Leave the key blank and the app logs invite and reset links
# to the console instead of sending them, which is what you want in development.
# EMAIL_FROM can stay on the shared resend.dev address until you verify your own domain.
RESEND_API_KEY=
EMAIL_FROM=Nara <onboarding@resend.dev>
RESET_TOKEN_HOURS=1

# Error alerting. Blank means Sentry is off, which is what you want locally.
# Crashes are reported with the same request id the caller was given, so a support message
# quoting it finds the event.
SENTRY_DSN=
# Performance tracing is billed per transaction and is off by default. Errors are the point.
SENTRY_TRACES_SAMPLE_RATE=0.0

TRIAL_DAYS=14
TRIAL_SEAT_LIMIT=10
INVITE_EXPIRY_DAYS=7
PAST_DUE_GRACE_DAYS=7

# Sign-in throttling. Per-IP limits belong at the proxy or CDN, not in the app process.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# Geofencing
MAX_GPS_ACCURACY_M=100
DEFAULT_ZONE_RADIUS_M=150
OPEN_SHIFT_FLAG_HOURS=12
